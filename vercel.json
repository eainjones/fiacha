{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/crawl-rss",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/crawl-oireachtas",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/crawl-rss",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/crawl-web",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/crawl-rss",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/crawl-oireachtas",
      "schedule": "0 22 * * *"
    }
  ]
}
