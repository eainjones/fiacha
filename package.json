{
  "name": "fiacha",
  "version": "1.0.0",
  "scripts": {
    "dev": "bash scripts/dev-clean.sh && next dev -p 4000",
    "dev:quick": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:api",
    "test:api": "npx tsx scripts/test-endpoints.ts",
    "test:all": "npm run validate && npm run test:api",
    "validate": "npx tsx scripts/validate-data.ts",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:push": "supabase db push",
    "db:push:local": "supabase db push --local",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset",
    "db:status": "supabase migration list",
    "types:update": "supabase gen types typescript --local > lib/database.types.ts",
    "import:politicians": "npx tsx scripts/import-politicians.ts",
    "import:politicians:dry": "DRY_RUN=true npx tsx scripts/import-politicians.ts",
    "data:clean": "python3 scripts/clean_data.py",
    "data:calculate-totals": "python3 scripts/calculate_motion_totals.py",
    "data:all": "npm run data:clean && npm run data:calculate-totals && npm run validate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@hookform/resolvers": "^5.2.2",
    "@mastra/core": "^1.1.0",
    "@mendable/firecrawl-js": "^1.10.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.78.0",
    "@types/pg": "^8.15.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.5",
    "openai": "^4.77.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "resend": "^6.4.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
