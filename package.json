{
  "name": "fiacha",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:api",
    "test:api": "npx tsx scripts/test-endpoints.ts",
    "test:all": "npm run validate && npm run test:api",
    "validate": "npx tsx scripts/validate-data.ts",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset",
    "db:status": "supabase migration list",
    "types:update": "supabase gen types typescript --linked 2>/dev/null > lib/database.types.ts",
    "import:politicians": "npx tsx scripts/import-politicians.ts",
    "import:politicians:dry": "DRY_RUN=true npx tsx scripts/import-politicians.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.78.0",
    "@types/pg": "^8.15.5",
    "next": "14.2.5",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
