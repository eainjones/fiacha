{
  "name": "fiacha-crawler",
  "version": "1.0.0",
  "description": "Automated promise extraction service using Firecrawl",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "review": "tsx src/review/cli-review.ts",
    "crawl": "tsx src/index.ts all",
    "crawl:oireachtas": "tsx src/index.ts oireachtas",
    "crawl:rss": "tsx src/index.ts rss",
    "crawl:web": "tsx src/index.ts web",
    "crawl:tier1": "tsx src/index.ts tier1",
    "crawl:tier2": "tsx src/index.ts tier2",
    "crawl:tier3": "tsx src/index.ts tier3",
    "crawl:councils": "tsx scrape-councils.ts",
    "crawl:weekend": "tsx weekend-council-crawl.ts",
    "crawl:weekend:batch": "tsx weekend-council-crawl.ts --batch",
    "crawl:weekend:dry-run": "tsx weekend-council-crawl.ts --dry-run",
    "council:status": "tsx council-status.ts",
    "council:merge": "tsx merge-councillors.ts",
    "test": "tsx src/test.ts",
    "crawl:schedule": "tsx src/scheduler.ts",
    "test:email": "tsx test-email.ts"
  },
  "keywords": [
    "firecrawl",
    "promise-tracking",
    "politics",
    "ireland"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@mastra/core": "^1.1.0",
    "@mendable/firecrawl-js": "^1.10.0",
    "dotenv": "^16.4.5",
    "fuse.js": "^7.0.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "resend": "^6.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
