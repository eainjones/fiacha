# Firecrawl API
FIRECRAWL_API_KEY=fc-your-api-key-here

# LLM Providers (choose one or both for testing)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Database Connection (same as main Fiacha app)
DATABASE_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# LLM Provider Selection (claude|openai)
LLM_PROVIDER=claude

# Crawler Settings
CRAWL_BATCH_SIZE=5
CRAWL_DELAY_MS=2000
MAX_RETRIES=3
