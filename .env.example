# Database Connection
# Local: run `supabase start` then use the local connection string
# Remote: Get from Supabase Dashboard -> Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase Authentication
# Local: these are the default local Supabase keys (from `supabase status`)
# Remote: Get from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key (for admin operations)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js API URL
# Local: http://localhost:3000
# Vercel: Automatically set via VERCEL_URL
NEXT_PUBLIC_API_URL=http://localhost:3000
